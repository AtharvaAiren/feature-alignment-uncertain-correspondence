{
  "schema_version": "beyond_marginals.rotation_extension.config.v1",
  "campaign_id": "beyond_marginals_rotation_breaker_v1",
  "description": "Bures-first low-rank orientation recovery from unpaired soft pseudo-label anchors",
  "play1_lock": "protocol/iclr_extension_play1_lock.json",
  "extension_lock": "protocol/iclr_extension_master_lock.json",
  "source_campaign_config": "configs/campaign/campaign_full.json",
  "feature_root_environment": "MARGINAL_FEATURE_ROOT",
  "output_root_environment": "MARGINAL_ROTATION_RESULTS",
  "global_seed": 20260812,
  "severity": 5,
  "calibration_size": 4096,
  "split_seeds": [101, 102, 103, 104, 105],
  "panels": {
    "primary": [
      "contrast",
      "defocus_blur",
      "glass_blur",
      "motion_blur",
      "zoom_blur"
    ],
    "diagnostic": ["brightness", "fog", "gaussian_noise"]
  },
  "datasets": {
    "cifar100_c": {
      "encoders": ["dinov3", "clip", "vitb16"],
      "evaluation_size": 3000
    },
    "imagenet_c": {
      "encoders": ["dinov3", "clip", "vitb16"],
      "evaluation_size": 10000
    }
  },
  "method": {
    "covariance_estimator": "oas",
    "relative_floor": 0.000001,
    "candidate_ranks": [2, 4, 8, 16, 32],
    "procrustes_shrinkages": [0.1, 1.0, 10.0],
    "confidence_threshold": 0.6,
    "temperature": 1.0,
    "validation_fraction": 0.25,
    "minimum_fit_rows": 64,
    "minimum_validation_rows": 32,
    "minimum_relative_improvement": 0.01,
    "minimum_active_classes": 8,
    "minimum_effective_class_mass": 1.0,
    "rank_support_rule": "active_classes_at_least_max_8_2r_plus_1",
    "minimum_explained_discrepancy_energy": 0.5,
    "minimum_fit_validation_subspace_stability": 0.05,
    "null_permutations": 19,
    "null_quantile": 0.95,
    "null_interpretation": "conservative_heuristic_selection_gate_not_a_significance_test_or_identification_claim",
    "refit_selected_specification_on_all_calibration": true,
    "dataset_mass_thresholds": {
      "cifar100_c": {"fit": 8.0, "validation": 2.0},
      "imagenet_c": {"fit": 0.75, "validation": 0.2}
    },
    "failure_policy": "return_exact_bures_map"
  },
  "metrics": {
    "primary": "reference_prediction_agreement",
    "secondary": [
      "aligned_accuracy",
      "centered_logit_mse",
      "paired_feature_mse",
      "negative_log_likelihood",
      "expected_calibration_error"
    ],
    "directions": {
      "reference_prediction_agreement": "higher_is_better",
      "aligned_accuracy": "higher_is_better",
      "centered_logit_mse": "lower_is_better",
      "paired_feature_mse": "lower_is_better",
      "negative_log_likelihood": "lower_is_better",
      "expected_calibration_error": "lower_is_better"
    },
    "sign_normalized_improvement": "positive_is_better_for_every_metric"
  },
  "uncertainty": {
    "unit": "dataset_corruption_condition_cluster",
    "panel_cluster_counts": {
      "primary": 10,
      "diagnostic": 6
    },
    "encoders": "paired_and_nested_within_cluster",
    "split_reduction": "mean_within_condition_before_cluster_resampling",
    "bootstrap": "dataset_corruption_cluster_bootstrap",
    "replicates": 10000,
    "seed": 20260827,
    "confidence_level": 0.95,
    "interval_interpretation": "descriptive_finite_prespecified_panel_heterogeneity_not_population_sampling_inference"
  }
}
