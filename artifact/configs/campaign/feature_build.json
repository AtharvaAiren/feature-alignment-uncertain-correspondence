{
  "schema_version": "marginal_alignment.campaign.feature_build.v1",
  "output_dtype": "float32",
  "inference_precision": "float32",
  "batch_size": 128,
  "workers": 8,
  "encoders": {
    "dinov3": {
      "backend": "transformers_auto_cls",
      "model_id": "facebook/dinov3-vitl16-pretrain-lvd1689m",
      "model_path_environment": "MARGINAL_DINOV3_MODEL",
      "expected_dimension": 1024,
      "feature_layer": "last_hidden_state[:,0]",
      "pooling": "class_token"
    },
    "clip": {
      "backend": "transformers_clip_projection",
      "model_id": "openai/clip-vit-large-patch14",
      "model_path_environment": "MARGINAL_CLIP_MODEL",
      "expected_dimension": 768,
      "feature_layer": "vision_model.post_layernorm+visual_projection",
      "pooling": "projected_class_token"
    },
    "vitb16": {
      "backend": "timm_pre_logits",
      "model_id": "vit_base_patch16_224.augreg_in21k_ft_in1k",
      "model_path_environment": "MARGINAL_VITB16_CHECKPOINT",
      "expected_dimension": 768,
      "feature_layer": "forward_head(pre_logits=True)",
      "pooling": "class_token"
    }
  },
  "datasets": {
    "cifar100_c": {
      "clean_root_environment": "MARGINAL_CIFAR100_ROOT",
      "corruption_root_environment": "MARGINAL_CIFAR100C_ROOT",
      "corruption_provenance_environment": "MARGINAL_CIFAR100C_PROVENANCE",
      "reference_split": "test",
      "head_fit_split": "train",
      "rows_per_condition": 10000,
      "severities": [1, 3, 5],
      "head_protocol": {
        "kind": "clean_linear_probe",
        "solver": "multinomial_logistic_lbfgs",
        "max_train_rows": 50000,
        "seed": 1729
      }
    },
    "imagenet_c": {
      "clean_root_environment": "MARGINAL_IMAGENET_VAL_ROOT",
      "corruption_root_environment": "MARGINAL_IMAGENETC_ROOT",
      "corruption_provenance_environment": "MARGINAL_IMAGENETC_PROVENANCE",
      "reference_split": "val",
      "head_fit_split": "val",
      "rows_per_condition": 50000,
      "severities": [1, 3, 5],
      "head_protocol": {
        "kind": "stratified_clean_linear_probe",
        "shots_per_class": 25,
        "seed": 1729
      }
    }
  },
  "readout_realization": {
    "estimator": "sklearn.linear_model.LogisticRegression",
    "solver": "lbfgs",
    "C": 1.0,
    "fit_intercept": true,
    "feature_standardization": "clean_fit_mean_and_population_std_then_fold_into_readout",
    "max_iter": 2000,
    "tol": 0.001,
    "convergence_policy": "fail_if_solver_reaches_max_iter"
  }
}
